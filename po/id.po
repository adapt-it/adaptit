#: Adapt_It.cpp:5467
#, c-format
msgid ""
"The AI_UserProfiles.xml file was not located at the following path:\n"
"   %s\n"
"A new AI_UserProfiles.xml file will be created there."
msgstr ""
"Arsip \"AI_UserProfiles.xml\" tidak terletak di map berikut:\n"
"   %s\n"
"Sebuah arsip \"AI_UserProfiles.xml\" yang baru akan dibuat di map tersebut."

#: Adapt_It.cpp:5495
#, c-format
msgid ""
"Unable to open the AI_UserProfiles.xml file at the following path:\n"
"   %s\n"
"Changes to user workflow profiles will not be saved.\n"
"Ensure that the AI_UserProfiles.xml file is not open in another program, "
"then try again."
msgstr ""
"Tidak dapat membuka arsip \"AI_UserProfiles.xml\" pada map berikut:\n"
"   %s\n"
"Perubahan profil alur kerja pengguna tidak akan disimpan.\n"
"Pastikan bahwa arsip \"AI_UserProfiles.xml\" tidak terbuka di program lain, "
"kemudian coba lagi."

#: Adapt_It.cpp:5610
msgid ""
"Adapt It could not upgrade AI_UserProfiles.xml (modified) with the newer "
"version from the last Adapt It installation.\n"
"AI_UserProfiles.xml may be in use by another program."
msgstr ""
"Adapt It tidak bisa memperbarui arsip \"AI_UserProfiles.xml\" (yang telah "
"dimodifikasi) dengan versi yang lebih baru dari instalasi Adapt It terkini.\n"
"File \"AI_UserProfiles.xml\" mungkin sedang digunakan oleh program lain."

#: Adapt_It.cpp:5619
msgid "Unable to remove existing AI_UserProfiles.xml file"
msgstr "Tidak dapat menghapus arsip \"AI_UserProfiles.xml\" yang lama"

#: Adapt_It.cpp:5654 Adapt_It.cpp:5666
msgid "Unable to create a new AI_UserProfiles.xml file"
